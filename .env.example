# Copy this file to .env.local for local development.
# In Vercel: Project -> Settings -> Environment Variables. Each variable
# has an environment scope (Production / Preview / Development). The
# variables marked [DIFFERS] below MUST have different values for
# Production and Preview (staging) — see docs/staging notes in the
# chat checklist. Keep the variable NAMES identical in every environment.
# NEXT_PUBLIC_* values are baked into the build at deploy time, so
# changing one in Vercel needs a redeploy to take effect.

# --- Database (Prisma) [DIFFERS] ---------------------------------------
# Supabase Dashboard -> Connect -> ORM -> Prisma. TWO different strings:
# DATABASE_URL is the pooled connection (port 6543, transaction mode)
# the running app uses — note the required ?pgbouncer=true. DIRECT_URL is
# the direct connection (port 5432, session mode) that `prisma migrate`
# uses — no pgbouncer flag there. Mixing them up is a common source of
# confusing failures.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# --- Supabase (Project Settings -> API) [DIFFERS] -----------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# --- Site URL [DIFFERS] --------------------------------------------------
# The public address of THIS deployment, no trailing slash. Used to build
# the Paystack return link for print orders (pages/api/print-orders). If
# unset, that link becomes a relative path and the payment redirect breaks.
NEXT_PUBLIC_SITE_URL=https://evoke.booostglobal.com

# --- Paystack (Settings -> API Keys & Webhooks) [DIFFERS] --------------
# Test keys (sk_test_/pk_test_) for Preview/staging, live keys for
# Production. Test and live modes have SEPARATE webhook URLs in the
# Paystack dashboard; set both to <that environment's URL>/api/print-orders/webhook
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# --- Print orders [DIFFERS] ---------------------------------------------
# Where the "new print order" notification (with the book PDF link) is
# emailed. Use a team inbox in Preview so the real printer is never
# emailed for test orders.
PRINT_ORDER_ADMIN_EMAIL=orders@yourdomain.com

# --- Email (Resend) -----------------------------------------------------
# RESEND_FROM_EMAIL must be a verified sender/domain in your Resend
# account or sends are rejected. Leave RESEND_API_KEY unset and the app
# skips sending (logs a warning) instead of erroring — handy in staging.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=Evoke <hello@yourdomain.com>

# --- AI providers (use separate keys with spend caps for Preview) ------
# Anthropic — console.anthropic.com (story text)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# OpenAI — platform.openai.com (illustrations, model set in lib/imageConfig.js)
OPENAI_API_KEY=sk-xxxxxxxx
# ElevenLabs — elevenlabs.io -> profile -> API Keys (narration). A paid
# plan is required to use library voices through the API. When creating
# the key, restrict it to Text to Speech only.
ELEVENLABS_API_KEY=xxxxxxxx

# --- Admin / tuning -----------------------------------------------------
# A secret you make up (long random string) — required for
# /api/admin/regenerate-characters and force-regeneration. Use a
# different value per environment. Unset = those routes are blocked.
ADMIN_SECRET=
# "low" | "medium" | "high". Set "low" in Preview/local so testing doesn't
# run up flagship-quality image costs on every click.
IMAGE_QUALITY=medium

# --- LEGACY (old pre-rewrite /subscribe page only) ---------------------
# Not used by any current Evoke flow; safe to leave unset.
NEXT_PUBLIC_PAYSTACK_PLAN_SHORT=
NEXT_PUBLIC_PAYSTACK_PLAN_STANDARD=
NEXT_PUBLIC_PAYSTACK_PLAN_LONG=
