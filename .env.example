# Copy this file to .env.local for local development.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Prisma — from Supabase Dashboard → Connect → ORM → Prisma. TWO different
# connection strings, not one: DATABASE_URL is the pooled connection (port
# 6543, transaction mode) the running app uses — note the required
# ?pgbouncer=true, which tells Prisma to disable a feature PgBouncer's
# transaction mode can't support. DIRECT_URL is the direct connection
# (port 5432, session mode) `prisma migrate` uses — no pgbouncer flag
# needed there. Using the pooled one for migrations, or forgetting
# ?pgbouncer=true on the pooled one, are both common sources of confusing
# failures — keep the two straight.
DATABASE_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:[YOUR-PASSWORD]@aws-1-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to the browser

# Paystack — Settings → API Keys & Webhooks (use test keys until you go live)
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx

# Paystack subscription plan codes — one per Basic-tier page length, create
# these under Paystack Dashboard → Payments → Plans, all set to bill
# MONTHLY (see README "Accounts & subscriptions setup" for the exact
# prices to set each one at). Without these, /subscribe shows a clear
# error instead of failing silently. Subscriptions used to be one flat
# monthly/yearly plan; they're per page-length now, capped at 5
# books/month each — see lib/pricing.js.
NEXT_PUBLIC_PAYSTACK_PLAN_SHORT=PLN_xxxxxxxx
NEXT_PUBLIC_PAYSTACK_PLAN_STANDARD=PLN_xxxxxxxx
NEXT_PUBLIC_PAYSTACK_PLAN_LONG=PLN_xxxxxxxx

# Resend — resend.com → API Keys (email delivery: order receipts with the
# PDF attached). RESEND_FROM_EMAIL must be a verified sender/domain in your
# Resend account, or sends are rejected. Leave RESEND_API_KEY unset during
# local dev and the app just skips sending (logs a warning) instead of
# erroring.
RESEND_API_KEY=re_xxxxxxxx
RESEND_FROM_EMAIL=StoryNest <hello@yourdomain.com>

# Anthropic — console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# OpenAI — platform.openai.com → API Keys (used for Premium-tier character
# and illustration image generation via gpt-image-1.5). Swap for another
# provider's key if you change pages/api/generate-character-image.js and
# pages/api/generate-illustrations.js.
OPENAI_API_KEY=sk-xxxxxxxx

# A secret you make up yourself (any long random string) — required to use
# force:true on /api/get-or-generate-character or to call
# /api/admin/regenerate-characters at all. Without this set, force-regen is
# blocked entirely, which is the safe default — only set this when you
# actually need to force-regenerate a character after a prompt change.
ADMIN_SECRET=

# Optional — overrides the image quality tier set in lib/imageConfig.js.
# "low" | "medium" | "high". Leave unset to use the default ("medium").
# Useful to set "low" in a local/dev environment so testing doesn't run up
# flagship-quality image costs on every click.
IMAGE_QUALITY=medium
